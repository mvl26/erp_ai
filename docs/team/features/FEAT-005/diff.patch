+		return [f"{RUN_LOG_FILE}: no function {WRITE_ENTRY_FUNCTION} (ADR-024)"]
+	aliases = import_aliases(tree)
+	calls = [node for node in _own_nodes(function) if isinstance(node, ast.Call)]
