{
  "enabledPlugins": {
    "team@automation-ai": true
  },
  "agent": "team:team-leader",
  "permissions": {
    "allow": [
      "Bash(cd ../.. && bench setup requirements --dev && bench --site miyano install-app erp_ai *)",
      "Bash(cd ../.. && bench build --app erp_ai *)",
      "Bash(cd ../.. && bench --site miyano run-tests --app erp_ai *)",
      "Bash(cd ../.. && bench --site miyano run-tests --module \"$(echo *)",
      "Bash(pre-commit run --all-files *)",
      "Bash(pre-commit run --files *)",
      "Bash(cd ../.. && bench start *)",
      "Bash(cd ../.. && bench --site miyano migrate *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(jq *)",
      "Bash(python3 *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf *)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(./license.txt)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "skillOverrides": {}
}
