+				"GIT_COMMITTER_NAME": BOT_GIT_NAME,
+				"GIT_AUTHOR_EMAIL": BOT_GIT_EMAIL,
+				"GIT_COMMITTER_EMAIL": BOT_GIT_EMAIL,
+			}
+		)
