+def _set(*path_and_value):
+	"""Mutator setting config[p0][p1]... = value (last argument is the value)."""
+	*path, value = path_and_value
+
+	def mutate(config):
+		node = config
+		for key in path[:-1]:
+			node = node[key]
+		node[path[-1]] = value
+
+	return mutate
