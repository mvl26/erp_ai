+		super().tearDownClass()
+		after = real_core_repos_snapshot()
+		changed = [
+			f"{app}: {cls._real_core_repos_before[app]!r} -> {after.get(app)!r}"
+			for app in cls._real_core_repos_before
+			if after.get(app) != cls._real_core_repos_before[app]
