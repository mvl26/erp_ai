+def _matching_brace(masked: str, open_at: int) -> int:
+	depth = 0
+	for i in range(open_at, len(masked)):
+		if masked[i] == "{":
+			depth += 1
+		elif masked[i] == "}":
+			depth -= 1
+			if depth == 0:
+				return i
+	return -1
