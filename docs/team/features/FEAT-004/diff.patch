+def _hand_digest(doc) -> str:
+	values = [
+		doc.change_kind,
+		doc.app,
+		doc.file_path,
+		doc.is_new_file,
+		doc.command_args,
+		doc.base_hash,
+		doc.content_before,
+		doc.content_after,
+		doc.after_hash,
+		doc.target_branch,
+		doc.upstream_ref,
+		doc.ahead_count,
+		doc.is_core_app,
+		doc.commit_message,
+	]
+	return hashlib.sha256(json.dumps(values, ensure_ascii=False).encode("utf-8")).hexdigest()
