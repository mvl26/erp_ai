+BRANCH_NOTE = "Commit sẽ vào nhánh develop của app helpdesk."
+UPSTREAM_NOTE = (
+	"Nhánh này theo origin/develop và đang đi trước 2 commit (tính theo lần fetch cuối trên máy chủ)."
