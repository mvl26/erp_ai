+				self.assertRegex(source, _button_pattern(label, method_path))
+
+		with self.subTest(rule="role check returns before any button"):
+			self.assertRegex(source, r"if \(!" + re.escape(ROLE_CHECK) + r"\) \{\s*return;\s*\}")
