+	def _git_scan(self) -> GitScan:
+		for rel in (SOURCE_TOOL_FILE, PROCESS_RUNNER_FILE, CONSTANTS_FILE, CHANGE_GUARD_FILE, *NO_GIT_FILES):
+			self.assertIn(rel, self.sources)
+		return GitScan(self.sources)
