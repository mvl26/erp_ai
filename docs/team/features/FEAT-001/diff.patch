+			_text(do_tin_cay="Rất cao"),
+			_text(do_tin_cay=None),
+			json.dumps({k: v for k, v in VALID.items() if k != "dau_muc"}),
+			json.dumps({k: v for k, v in VALID.items() if k != "do_tin_cay"}),
+			"```json\n" + _text() + "\n```\n```json\n" + _text() + "\n```",
