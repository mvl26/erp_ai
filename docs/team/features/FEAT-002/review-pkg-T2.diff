+	def _stored(self, fieldname):
+		rows = frappe.db.sql(
+			"select value from `tabSingles` where doctype=%s and field=%s", (SETTING_DOCTYPE, fieldname)
+		)
+		return rows[0][0] if rows else "<missing>"
+
+	def test_status_defaults_filled_only_when_missing(self):
