+# Hand-written (F-1): the bound of the `actions` column in bytes and the marker of a cut.
+ACTIONS_BOUND = 60000
+CUT = "[đã cắt]"
+IDENTITY_KEYS = ("tool", "doctype", "name", "ok", "instructor")
