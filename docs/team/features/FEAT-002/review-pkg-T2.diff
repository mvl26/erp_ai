+		frappe.db.set_single_value(SETTING_DOCTYPE, "answer_delay_max_s", 0)
+		frappe.db.delete("Singles", {"doctype": SETTING_DOCTYPE, "field": "trigger_keyword"})
+		install.ensure_setup()
